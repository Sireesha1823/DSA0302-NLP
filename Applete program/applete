import java.applet.Applet;
import java.awt.*;
public class DisplayApplet extends Applet{
    public void paint(Graphics g){
        g.setColour(Colour.BLUE);
        g.drawString("Java Applet",50,40);

        g.setColour(Colour.RED);
        g.drawLine(50,60,250,60);

        g.setColour(Colour.GREEN);
        g.drawRect(50,80,150,80);

        g.setColour(Colour.ORANGE);
        g.fillOval(250,80,100,80);
    }
}